{
  "name": "social-archiver",
  "private": true,
  "version": "1.2.5",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && python -m unittest discover -s tests -t . -p \"test_*.py\"",
    "test:watch": "vitest",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-check.ps1",
    "release:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-pack.ps1",
    "version:print": "node scripts/print-version.mjs",
    "electron:dev:inner": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron --disable-gpu --disable-features=WebGL,WebGL2,WebGLRenderingContext .\"",
    "electron:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/electron-dev.ps1",
    "electron:build": "python scripts/write_icon.py && npm run build && python scripts/build_backend.py && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/electron-build.ps1"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^34.5.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.11.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.8",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.social-archiver.app",
    "productName": "Social Archiver",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "electron/**/*",
      "electron-archives.js",
      "archive-post-time.js",
      "preload.js",
      "json-lines.js",
      "settings-merge.js",
      "electron-search.js",
      "electron-stats.js",
      "electron-export-md.js",
      "electron-rss.js",
      "electron-export-json.js",
      "electron-update-log.js",
      "electron-scheduler.js",
      "app-paths.js",
      "icons/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-backend/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Social Archiver",
      "include": "build/installer.nsh"
    },
    "artifactName": "SocialArchiver-${version}-win.${ext}"
  }
}
